  "container": "<div class=\"two-columns-left\" id=\"container\">\n<main class=\"main\" id=\"main\" role=\"main\">\n<article class=\"post-1500 page type-page status-publish hentry\" id=\"post-1500\">\n<div class=\"schema-image\">\n</div>\n<div class=\"article-inner\">\n<header>\n<h1 class=\"entry-title singular-title\" itemprop=\"headline\">Webinars and Podcasts</h1> <span class=\"entry-meta\">\n</span>\n</header>\n<div class=\"entry-content\" itemprop=\"text\">\n\n<h1 class=\"wp-block-heading\">Webinars and Podcasts</h1>\n<h2 class=\"wp-block-heading\"><strong>Upcoming </strong>Webinars</h2>\n<div class=\"wp-block-media-text alignwide is-stacked-on-mobile\"><figure class=\"wp-block-media-text__media\"><img alt=\"\" class=\"wp-image-1662\" decoding=\"async\" height=\"137\" sizes=\"(max-width: 339px) 100vw, 339px\" src=\"/wp-content/uploads/2020/08/apha-logo.png\" srcset=\"/wp-content/uploads/2020/08/apha-logo.png 339w, /wp-content/uploads/2020/08/apha-logo-300x121.png 300w\" width=\"339\"/></figure><div class=\"wp-block-media-text__content\">\n<p class=\"has-large-font-size\"><strong><a href=\"https://nam02.safelinks.protection.outlook.com/?url=https%3A%2F%2Fampublichealth.wufoo.com%2Fforms%2Fm1b8br2z0yl9yg6%2F&amp;data=01%7C01%7CTyler_Prochnow1%40baylor.edu%7C4e7596f7da934455ebf908d84ded21a6%7C22d2fb35256a459bbcf4dc23d42dc0a4%7C0&amp;sdata=XfzJZfrrKfDaJv0XvT0hEGIeaVADUxvXA3qMQPGp31M%3D&amp;reserved=0\">Training the Next Generation of Physical Activity Researchers through a Health Equity Lens: Students and Post-Docs of PARC</a></strong></p>\n<p class=\"has-regular-font-size\">September 30, 12-1 PM ET <a href=\"https://ampublichealth.wufoo.com/forms/m1b8br2z0yl9yg6/\">(REGISTER NOW)</a></p>\n</div></div>\n<h2 class=\"wp-block-heading\"><strong>Recorded Webinars and Podcasts</strong></h2>\n<div class=\"wp-block-media-text alignwide\"><figure class=\"wp-block-media-text__media\"><img alt=\"\" class=\"wp-image-1505\" decoding=\"async\" fetchpriority=\"high\" height=\"538\" sizes=\"(max-width: 1024px) 100vw, 1024px\" src=\"/wp-content/uploads/2020/03/PlayCore-Logo_Facebook-1024x538.jpg\" srcset=\"/wp-content/uploads/2020/03/PlayCore-Logo_Facebook-1024x538.jpg 1024w, /wp-content/uploads/2020/03/PlayCore-Logo_Facebook-300x158.jpg 300w, /wp-content/uploads/2020/03/PlayCore-Logo_Facebook-768x403.jpg 768w, /wp-content/uploads/2020/03/PlayCore-Logo_Facebook-571x300.jpg 571w, /wp-content/uploads/2020/03/PlayCore-Logo_Facebook.jpg 1200w\" width=\"1024\"/></figure><div class=\"wp-block-media-text__content\">\n<p class=\"has-large-font-size\"><strong><a href=\"https://www.playcore.com/events/playcore-scholar-series\">PlayCORE-PARC Scholar Series</a>:</strong></p>\n<ul class=\"wp-block-list\"><li><strong>Parks as Equitable Resources for Youth Physical Activity, Especially Now</strong>: April 28, 2-3:15 PM ET \u2013 <a href=\"https://attendee.gotowebinar.com/recording/819944710292284684\">(Recording)</a></li><li><strong>Youth Advocacy for Better and Equitable Physical Activity Environments</strong>: June 11, 2-3:15 PM ET \u2013 <a href=\"https://register.gotowebinar.com/recording/2878575725113310733\">(Recording)</a></li><li><strong>Bringing Play Opportunities to ALL Kids through Play Streets</strong>: Aug. 12, 2-3:15 PM ET \u2013 (<a href=\"https://register.gotowebinar.com/register/2087304484618163724\">REGISTER NOW</a>)</li></ul>\n</div></div>\n<div class=\"wp-block-media-text alignwide\"><figure class=\"wp-block-media-text__media\"><img alt=\"\" class=\"wp-image-1507\" decoding=\"async\" height=\"115\" sizes=\"(max-width: 343px) 100vw, 343px\" src=\"/wp-content/uploads/2020/03/D4H_Header_Left_logo1-1.jpg\" srcset=\"/wp-content/uploads/2020/03/D4H_Header_Left_logo1-1.jpg 343w, /wp-content/uploads/2020/03/D4H_Header_Left_logo1-1-300x101.jpg 300w\" width=\"343\"/></figure><div class=\"wp-block-media-text__content\">\n<p class=\"has-large-font-size\"><strong>Active Play for All Children:\u00a0Building Evidence and Advancing a Culture of Health</strong></p>\n<p class=\"has-regular-font-size\"> July 16, 1-2:30 PM ET \u2013 <a href=\"https://www.dialogue4health.org/web-forums/detail/active-play-for-all-children\">(Recording)</a></p>\n</div></div>\n<ul class=\"wp-block-list\"><li><a href=\"https://attendee.gotowebinar.com/recording/819944710292284684\">Parks as Equitable Resources for Youth Physical Activity, Especially Now</a> \u2013 April 2020 </li><li><a href=\"https://jphmpdirect.com/2019/10/10/creative-solutions-rural-communities-interview-renee-umstattd-meyer/\">Views from the Front Porch: Rural Physical Activity. Creative Solutions at the Heart of Rural America</a> \u2013 October 2019 </li><li><a href=\"https://www.nrpa.org/blog/does-our-built-environment-impact-our-health-behaviors-episode-028/\">Does our Built Environment Impact Our Health Behaviors?</a> \u2013 October 2018</li><li><a href=\"https://americawalks.org/opportunities-for-walkability-in-rural-communities-and-small-towns-july-11-2018-webinar/\">Opportunities for Walkability in Rural Communities and Small Towns</a> \u2013 June 2018 </li></ul>\n<p></p>\n </div><!-- .entry-content -->\n<span class=\"schema-publisher\" itemprop=\"publisher\" itemscope=\"\" itemtype=\"https://schema.org/Organization\">\n<span itemprop=\"logo\" itemscope=\"\" itemtype=\"https://schema.org/ImageObject\">\n<meta content=\"/\" itemprop=\"url\"/>\n</span>\n<meta content=\"Physical Activity Research Center\" itemprop=\"name\"/>\n</span>\n<link href=\"/relevant-resources/webinars-and-podcasts/\" itemprop=\"mainEntityOfPage\"/> </div><!-- .article-inner -->\n</article><!-- #post-## -->\n<section id=\"comments\">\n</section><!-- #comments -->\n</main><!-- #main -->\n<aside class=\"widget-area sidey\" id=\"primary\" itemscope=\"\" itemtype=\"http://schema.org/WPSideBar\" role=\"complementary\">\n<section class=\"widget-container widget_search\" id=\"search-2\">\n<form action=\"/\" class=\"searchform\" method=\"get\" role=\"search\">\n<label>\n<span class=\"screen-reader-